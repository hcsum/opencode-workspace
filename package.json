{
  "name": "opencode-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenCode workspace with skills, notes, and email bridge",
  "scripts": {
    "bridge": "bash scripts/bridge.sh",
    "tui": "mkdir -p .data && OPENCODE_DB=\"$PWD/.data/opencode.db\" opencode .",
    "start": "bash scripts/server.sh",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate-ingest": "tsx src/validate-ingest.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.207",
    "@opencode-ai/sdk": "^1.18.8",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^16.6.1",
    "imapflow": "^1.4.7",
    "mailparser": "^3.9.14",
    "nodemailer": "^9.0.3",
    "playwright-core": "^1.54.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.15.21",
    "@types/nodemailer": "^8.0.1",
    "marked": "^18.0.10",
    "prettier": "^3.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
